# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Platform
NEXT_PUBLIC_PLATFORM_DOMAIN=yourdomain.com
SUPER_ADMIN_EMAILS=you@example.com

# AI / integrations
ANTHROPIC_API_KEY=your-anthropic-key
REPLICATE_API_TOKEN=your-replicate-token
RESEND_API_KEY=your-resend-key

# Stripe — live key always stays here
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe test mode — set STRIPE_MODE=test to use test key instead of live key.
# Your live key is never touched. Use test webhook secret from Stripe test dashboard.
STRIPE_MODE=
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_...

# Test bypass — comma-separated emails that skip Stripe checkout (dev/staging only)
# Leave empty or omit entirely in production
TEST_BYPASS_EMAILS=
